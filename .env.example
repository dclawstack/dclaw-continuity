# ─── Backend ─────────────────────────────────────────────────────────────
APP_NAME=DClaw Continuity
APP_ENV=dev
DEBUG=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dclaw_continuity

# ─── Auth (email + password sessions, JWT-signed) ────────────────────────
# AUTH_DEV_MODE accepts DEV_AUTH_TOKEN as a bypass — keep TRUE only in dev.
AUTH_DEV_MODE=true
DEV_AUTH_TOKEN=dev-token
# IMPORTANT: in production, set SECRET_KEY to a long random value (>= 32 bytes).
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-32-byte-dev-only-secret!
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256

# ─── LLM (OpenRouter primary, Ollama fallback) ───────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=moonshotai/kimi-k2

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Used for RAG embeddings (768-dim). To enable RAG locally:
#   ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text

LLM_REQUEST_TIMEOUT=60
# Local CPU Ollama is slow. The Ollama read timeout scales with the assumed
# token budget using this throughput; lower it for slower hardware, raise it
# for an M-series Mac with a fast model.
OLLAMA_TOKENS_PER_SECOND=4.0
OLLAMA_ASSUMED_MAX_TOKENS=1500

# ─── RAG ────────────────────────────────────────────────────────────────
EMBEDDING_DIM=768
RAG_TOP_K=5

# ─── Redis (cache) ───────────────────────────────────────────────────────
# Leave REDIS_URL empty to disable; callers degrade to no-cache.
REDIS_URL=redis://localhost:6379/0
REDIS_EMBED_CACHE_TTL_SECONDS=604800

# ─── Object storage (S3 / MinIO) ─────────────────────────────────────────
# Leave S3_ENDPOINT_URL empty to disable; attachment routes will return 503.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=dclaw-continuity
S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_URL_TTL_SECONDS=3600
S3_MAX_UPLOAD_BYTES=20971520

# ─── Frontend ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8150
